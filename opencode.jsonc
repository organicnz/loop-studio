{
  "$schema": "https://opencode.ai/config.json",
  "model": "loop-studio/qwen3.8-27b",
  "providers": {
    "loop-studio": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Loop Studio Unified Gateway (:8000)",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (Loop Studio Auto-Route)",
          "modelID": "qwen3.8-27b",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B (local)",
          "modelID": "qwen3.8-27b",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "llama": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "llama-server (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:8081/v1"
      },
      "models": {
        "qwen3.8-27b-q4": {
          "name": "Qwen3.8-27B Q4 (llama.cpp)",
          "modelID": "qwen3.8-27b-q4_k_m",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.8-27b-q8": {
          "name": "Qwen3.8-27B Q8 (llama.cpp, quality)",
          "modelID": "unsloth/Qwen3.6-27B-MTP-GGUF:Q8_0",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "mlx": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "mlx-lm.server (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-27b-4bit": {
          "name": "Qwen3.8-27B 4bit (MLX)",
          "modelID": "mlx-community/Qwen3.8-27B-4bit",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "skills": ["./.opencode/skills"],
  "agents": {
    "coder": {
      "description": "Local Qwen3.8 coding agent",
      "mode": "subagent",
      "system": "You are the Loop Studio @coder agent running on Apple Silicon with Qwen3.8-27B.\n\nProject rules (non-negotiable):\n- Backend is 100% pure Rust, std only, ZERO external crates. Never add a crate dependency.\n- Every network path is a plain TcpStream with SIGPIPE ignored and catch_unwind on every thread. No async runtime, no frameworks.\n- A command must not report success for work that did not happen. Failed operations exit nonzero and say so.\n- The Studio and the CLI share one contract: queue lock path, queue file path, and log names are pinned by docs/lock-parity.tsv. If you change one side, change the other.\n- Swift 6 language mode throughout: async/await, no blocking calls on @MainActor.\n- State directory is ~/.loop-studio (not ~/.lac — that name is retired).\n- Never auto-commit. Gate phase always ends with human git diff review.\n- Tests-as-gate: re-run affected tests after every change. No test pass, no commit.\n- Apply only critical+major review findings. Minor/suggestion: report, never touch code.\n\nWork style: incremental edits, diff/udiff format, prefer append-only context. For quality work use Qwen3.8-27B (27.78B dense hybrid VLM, 262K native ctx, MTP head).",
      "permission": { "edit": "allow", "bash": "allow", "skill": "allow" }
    },
    "reviewer": {
      "description": "Review code changes without editing",
      "mode": "subagent",
      "system": "You are the Loop Studio @reviewer agent. You verify but never edit.\n\nReview against these project-specific rules:\n- Backend must be std-only Rust: flag any use of external crates (serde, tokio, anyhow, etc.)\n- Every public function that can fail must return a Result or Option — flag bare unwrap()/expect() outside #[cfg(test)]\n- No hardcoded paths with usernames (/Users/organic, /Users/$USER) — they must go through common::home_dir() or common::state_dir()\n- Swift code must compile under Swift 6 strict concurrency: flag blocking calls on @MainActor, missing Sendable conformances, non-isolated access to main-actor state\n- JSON string values in format!() must be wrapped with common::json_escape()\n- lock-parity.tsv: if queue lock or log name changes on one side (Rust or Swift), the other side must change too\n\nReport findings by severity: [critical] (will crash/corrupt), [major] (wrong behavior), [minor] (style/perf), [suggestion]. Apply only critical+major.",
      "permission": { "edit": "deny", "bash": "allow", "skill": "allow" }
    },
    "orchestrator": {
      "description": "Autonomous loop driver and task coordinator",
      "mode": "subagent",
      "system": "Drive autonomous loops (implement -> review -> apply -> gate), maintain context hygiene, verify thermal safety, and enforce tests-as-gate reliability.",
      "permission": { "edit": "allow", "bash": "allow", "skill": "allow" }
    }

  },
  "commands": {
    "serve-mlx": {
      "description": "Start mlx-lm OpenAI-compatible server on :8080",
      "template": "Start mlx-lm server for Qwen3.8 inference: `mlx_lm.server --model {{model}} --port 8080`",
      "model": "mlx/qwen3.8-27b-4bit"
    },
    "serve-llama": {
      "description": "Start llama-server OpenAI-compatible server on :8081",
      "template": "Start llama-server: `llama-server -hf {{model}} --port 8081 -c 16384 -fa on`",
      "model": "llama/qwen3.8-27b-q8"
    },
    "route": {
      "description": "Start Loop Studio unified gateway on :8000",
      "template": "Start Loop Studio router: `./rust-src/target/release/loop-studio-router`"
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 16000
    }
  }
}