# Loop Studio — Local Agentic Coding Environment Variables
# Copy to .env and adjust for your setup.

# Unified Gateway & Endpoints
LOOP_STUDIO_GATEWAY_URL=http://127.0.0.1:8000/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_BASE_URL=http://127.0.0.1:8081/v1
MLX_BASE_URL=http://127.0.0.1:8080/v1

# Primary Model (Qwen 3.8 27B)
PRIMARY_MODEL=qwen3.8-27b
OLLAMA_MODEL=qwen3.8-27b
LLAMA_MODEL=unsloth/Qwen3.6-27B-MTP-GGUF:Q8_0
MLX_MODEL=mlx-community/Qwen3.8-27B-4bit

# Storage Paths (Studio TB5 External / Internal Fallback)
HF_HOME=/Volumes/AIModels/hf
HF_HUB_CACHE=/Volumes/AIModels/hf/hub
OLLAMA_MODELS=/Volumes/AIModels/ollama

# Time Machine exclusions
TM_EXCLUDE="/Volumes/AIModels ~/.ollama ~/.cache/huggingface"

# Router Configuration
LOOP_STUDIO_ROUTER_PORT=8000
LOOP_STUDIO_BACKEND=auto

# Gateway browser gates. Both default to refusing browsers, which is what you
# want: a loopback port is reachable by every web page you have open.
#   LOOP_STUDIO_ALLOWED_HOSTS   extra DNS names to serve, comma separated. IP
#                       literals and localhost always work; a name here is
#                       what keeps Tailscale MagicDNS reachable on a
#                       token-less gateway. A valid LOOP_STUDIO_API_TOKEN also opens
#                       any Host (it proves the client is not a rebound
#                       browser).
#   LOOP_STUDIO_ALLOWED_ORIGINS browser origins allowed to read responses, comma
#                       separated, e.g. https://studio.example. Native
#                       clients send no Origin and need no entry. `*` lets
#                       every page read the gateway — don't.
# LOOP_STUDIO_ALLOWED_HOSTS=
# LOOP_STUDIO_ALLOWED_ORIGINS=
